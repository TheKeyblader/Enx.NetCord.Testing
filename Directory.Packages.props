<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NetCordVersion>1.0.0-beta.30</NetCordVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="NetCord" Version="$(NetCordVersion)" />
    <PackageVersion Include="NetCord.Services" Version="$(NetCordVersion)" />
    <PackageVersion Include="NetCord.Hosting" Version="$(NetCordVersion)" />
    <PackageVersion Include="NetCord.Hosting.Services" Version="$(NetCordVersion)" />
    <PackageVersion Include="NetCord.Hosting.AspNetCore" Version="$(NetCordVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
